# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to GitHub.

# If you install MongoDB locally, this is usually the default:
MONGODB_URI=mongodb://127.0.0.1:27017/landscape_india

# If you use MongoDB Atlas (free cloud database) instead, it looks like:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/landscape_india

PORT=5000
